# Copy to `.env` (project root) for local development.
# On Render, set the same variables under Environment instead.

# Groq API key (https://console.groq.com/keys)
GROQ_API_KEY=your_actual_groq_api_key
LLM_MODEL=openai/gpt-oss-20b

# Comma-separated list of frontend origins allowed to call the API (CORS).
# Locally the Vite dev server (http://localhost:5173) is always allowed.
# On Render set it to your Vercel URL, e.g. https://your-app.vercel.app
FRONTEND_URL=http://localhost:5173

# Optional: regex for extra origins such as Vercel preview deployments.
# FRONTEND_URL_REGEX=https://your-app-.*\.vercel\.app
